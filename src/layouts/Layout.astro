---
import '../styles/global.css';
// 只引 latin 子集：站点正文中文走系统字体栈，西里尔/希腊/越南等子集纯属冗余产物
import '@fontsource/outfit/latin-400.css';
import '@fontsource/outfit/latin-500.css';
import '@fontsource/outfit/latin-600.css';
import '@fontsource/outfit/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
// 关键字体预加载：URL 与 fontsource CSS 内引用同源同哈希，避免首屏文字回退闪烁
import outfitLatin400 from '@fontsource/outfit/files/outfit-latin-400-normal.woff2';
import outfitLatin700 from '@fontsource/outfit/files/outfit-latin-700-normal.woff2';
import monoLatin400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'security-audit 安全审计：让编码智能体化身安全审计员',
  description = '面向 coding-agent 的安全审计技能：侦察、覆盖驱动搜寻、候选验证、结构化输出、独立核验与目标中立报告。六阶段、多智能体隔离协作。',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('og.png', Astro.site).href;
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="security-audit 安全审计" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={outfitLatin400} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={outfitLatin700} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={monoLatin400} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="security-audit 安全审计：六阶段、多智能体隔离协作的编码智能体安全审计技能" />
    <meta name="twitter:card" content="summary_large_image" />
    <noscript><style>[style*="opacity:0"]{opacity:1 !important;transform:none !important}.ticker-track{animation:none !important}</style></noscript>
    <script is:inline>
      try {
        const saved = localStorage.getItem('sa-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const dark = saved ? saved === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#09090b' : '#fafafa');
      } catch {}
    </script>
  </head>
  <body class="grain bg-zinc-50 text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <!-- 阅读进度：CSS scroll-driven，JS 不可用时静默退化为不显示 -->
    <div aria-hidden="true" class="scroll-progress fixed inset-x-0 top-0 z-50 h-[2px] bg-gradient-to-r from-emerald-600 via-emerald-400 to-emerald-600"></div>
    <slot />
    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      const label = document.getElementById('theme-toggle-label');
      const meta = document.querySelector('meta[name="theme-color"]');
      const syncTheme = () => {
        const dark = document.documentElement.classList.contains('dark');
        if (label) label.textContent = dark ? '深色模式' : '浅色模式';
        if (toggle) toggle.setAttribute('aria-pressed', String(dark));
        if (meta) meta.setAttribute('content', dark ? '#09090b' : '#fafafa');
      };
      syncTheme();
      toggle?.addEventListener('click', () => {
        const el = document.documentElement;
        const dark = !el.classList.contains('dark');
        el.classList.toggle('dark', dark);
        el.style.colorScheme = dark ? 'dark' : 'light';
        try { localStorage.setItem('sa-theme', dark ? 'dark' : 'light'); } catch {}
        syncTheme();
      });

      // 导航当前章节高亮：IntersectionObserver，不用 scroll 监听
      const navLinks = Array.from(document.querySelectorAll('a.nav-link[data-section]'));
      const sections = navLinks
        .map((a) => document.getElementById(a.getAttribute('data-section') || ''))
        .filter((el) => el !== null);
      if (sections.length > 0 && 'IntersectionObserver' in window) {
        const visible = new Map();
        const apply = () => {
          let current = null;
          for (const s of sections) if (visible.get(s)) current = s.id;
          navLinks.forEach((a) => {
            if (current && a.getAttribute('data-section') === current) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
          });
        };
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) visible.set(e.target, e.isIntersecting);
            apply();
          },
          { rootMargin: '-20% 0px -65% 0px' },
        );
        sections.forEach((s) => io.observe(s));
      }
    </script>
  </body>
</html>
