---
import { Reveal } from './react/Reveal';
import { EnvelopeSimpleIcon, GithubLogoIcon } from '@phosphor-icons/react';
---

<section class="relative overflow-hidden border-t border-zinc-200 dark:border-zinc-800">
  <div aria-hidden="true" class="glow-emerald pointer-events-none absolute bottom-0 left-1/2 h-[360px] w-[720px] -translate-x-1/2 translate-y-1/2"></div>
  <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <Reveal client:visible>
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold tracking-tighter md:text-3xl">有疑问或实战经验？<span class="text-emerald-700 dark:text-emerald-300">写信交流。</span></h2>
          <p class="mt-2 leading-relaxed text-zinc-600 dark:text-zinc-400">关于 AI 驱动安全工具的疑问、反馈或经验交流，联系 Cloudflare 安全 AI 研究团队。</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="mailto:security-ai-research@cloudflare.com" class="inline-flex items-center gap-2 rounded-full bg-zinc-900 px-6 py-2.5 text-sm font-medium text-white shadow-[0_12px_36px_-14px_rgb(16_185_129/0.6)] transition hover:bg-zinc-700 active:scale-[0.98] dark:bg-emerald-400 dark:text-emerald-950 dark:shadow-[0_12px_36px_-14px_rgb(16_185_129/0.7)] dark:hover:bg-emerald-300"><EnvelopeSimpleIcon size={16} weight="bold" aria-hidden />security-ai-research@cloudflare.com</a>
          <a href="https://github.com/cloudflare/security-audit-skill" target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-full border border-zinc-300 px-6 py-2.5 text-sm font-medium transition hover:border-emerald-500/60 hover:text-emerald-700 active:scale-[0.98] dark:border-zinc-700 dark:hover:text-emerald-300"><GithubLogoIcon size={16} weight="bold" aria-hidden />GitHub 仓库</a>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<footer class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-6 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 dark:text-zinc-400">
    <p><span class="font-semibold text-zinc-700 dark:text-zinc-300">security-audit 安全审计</span> · 中文文档站（非官方翻译，内容以原仓库为准）</p>
    <p class="font-mono text-xs">MIT License · Astro + React + TypeScript + Tailwind + Bun</p>
  </div>
</footer>
