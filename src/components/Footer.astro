---
import { Reveal } from './react/Reveal';
import { EnvelopeSimple, GithubLogo } from '@phosphor-icons/react';
---

<section class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <Reveal client:visible>
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-300">Contact · 联系与许可</p>
      <div class="mt-3 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold tracking-tighter md:text-3xl">有疑问或实战经验？写信交流。</h2>
          <p class="mt-2 leading-relaxed text-zinc-600 dark:text-zinc-400">关于 AI 驱动安全工具的疑问、反馈或经验交流，联系 Cloudflare 安全 AI 研究团队。</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="mailto:security-ai-research@cloudflare.com" class="inline-flex items-center gap-2 rounded-full bg-zinc-900 px-6 py-2.5 text-sm font-medium text-white transition hover:bg-zinc-700 active:scale-[0.98] dark:bg-emerald-400 dark:text-emerald-950 dark:hover:bg-emerald-300"><EnvelopeSimple size={16} weight="bold" aria-hidden />security-ai-research@cloudflare.com</a>
          <a href="https://github.com/cloudflare/security-audit-skill" target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-full border border-zinc-300 px-6 py-2.5 text-sm font-medium transition hover:border-emerald-500/60 active:scale-[0.98] dark:border-zinc-700"><GithubLogo size={16} weight="bold" aria-hidden />GitHub 仓库</a>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<footer class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-6 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p><span class="font-semibold text-zinc-700 dark:text-zinc-300">security-audit 安全审计</span> · 中文文档站（非官方翻译，内容以原仓库为准）</p>
    <p class="font-mono text-xs">MIT License · Astro + React + TypeScript + Tailwind + Bun</p>
  </div>
</footer>
