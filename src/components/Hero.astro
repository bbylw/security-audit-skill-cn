---
import { HeroTerminal } from './react/HeroTerminal';
import { docFiles, phases } from '../data/content';

const stats: [string, string][] = [
  [String(phases.length), '审计阶段'],
  [String(docFiles.filter((f) => f.group === 'hunt').length), '攻击面家族'],
  ['3', '判定类别'],
  [String(docFiles.filter((f) => f.group === 'ops' && f.name.endsWith('.cjs') && !f.name.includes('.test.')).length), '零依赖校验器'],
];
---

<section id="top" class="relative overflow-hidden">
  <!-- 氛围层：网格 + 徽标辉光 + 终端辉光，均 pointer-events-none -->
  <div aria-hidden="true" class="bg-grid bg-grid-fade absolute inset-0"></div>
  <div aria-hidden="true" class="glow-emerald pointer-events-none absolute -top-32 left-[8%] h-[420px] w-[420px]"></div>
  <div aria-hidden="true" class="glow-emerald pointer-events-none absolute right-[4%] top-[30%] h-[520px] w-[520px]"></div>

  <div class="relative mx-auto max-w-7xl px-4 pb-14 pt-14 sm:px-6 lg:pb-20 lg:pt-20">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="min-w-0">
        <p class="inline-flex items-center gap-2 rounded-full border border-emerald-600/25 bg-emerald-500/[0.08] px-3 py-1 font-mono text-[11px] uppercase tracking-[0.14em] text-emerald-700 dark:text-emerald-300">
          Cloudflare 漏洞发现框架 · 单仓库起点
        </p>
        <h1 class="mt-5 text-4xl font-bold leading-[1.05] tracking-tighter md:text-5xl lg:text-6xl">
          让编码智能体<br />
          化身<span class="relative whitespace-nowrap">安全审计员<svg aria-hidden="true" viewBox="0 0 220 12" class="absolute -bottom-1 left-0 w-full text-emerald-500/70" preserveAspectRatio="none"><path d="M3 9c40-5 130-6 214-3" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span>
        </h1>
        <p class="mt-5 max-w-[52ch] leading-relaxed text-zinc-600 dark:text-zinc-400">
          六阶段结构化审计，多智能体相互隔离：侦察建账、覆盖搜寻、对抗验证，最后派生目标中立报告。
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="#install" class="rounded-full bg-emerald-700 px-6 py-2.5 text-sm font-semibold text-white shadow-[0_12px_36px_-12px_rgb(16_185_129/0.6)] transition hover:bg-emerald-800 active:scale-[0.98] dark:bg-emerald-400 dark:text-emerald-950 dark:shadow-[0_12px_36px_-12px_rgb(16_185_129/0.7)] dark:hover:bg-emerald-300">快速开始</a>
          <a href="#workflow" class="rounded-full border border-zinc-300 px-6 py-2.5 text-sm font-medium transition hover:border-emerald-500/60 hover:text-emerald-700 active:scale-[0.98] dark:border-zinc-700 dark:hover:text-emerald-300">查看工作流</a>
        </div>
        <dl class="mt-9 grid max-w-md grid-cols-4 gap-4 border-t border-zinc-200 pt-5 dark:border-zinc-800">
          {stats.map(([n, label]) => (
            <div class="flex flex-col">
              <dt class="order-2 mt-1 text-xs text-zinc-500 dark:text-zinc-400">{label}</dt>
              <dd class="order-1 bg-gradient-to-b from-zinc-900 to-zinc-600 bg-clip-text font-mono text-2xl font-bold tracking-tight text-transparent dark:from-emerald-300 dark:to-emerald-600">{n}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="min-w-0">
        <HeroTerminal client:visible />
        <p class="mt-3 font-mono text-xs leading-relaxed text-zinc-500 dark:text-zinc-400">
          源自 <a class="underline decoration-emerald-500/50 underline-offset-4 hover:text-emerald-700 dark:hover:text-emerald-300" href="https://blog.cloudflare.com/build-your-own-vulnerability-harness" target="_blank" rel="noreferrer">《构建你自己的漏洞发现框架》</a> · 多次运行叠加覆盖，单次约发现累计漏洞的一半
        </p>
      </div>
    </div>
  </div>
</section>
