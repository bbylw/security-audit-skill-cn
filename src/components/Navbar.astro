---

<header class="sticky top-0 z-40 border-b border-zinc-200/70 bg-zinc-50/80 backdrop-blur-xl dark:border-zinc-800/70 dark:bg-zinc-950/75">
  <nav aria-label="主导航" class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6">
    <a href="/#top" class="group flex items-center gap-2.5">
      <span class="relative flex h-8 w-8 items-center justify-center rounded-xl bg-zinc-950 ring-1 ring-emerald-500/30 transition group-hover:ring-emerald-500/70 dark:bg-zinc-900">
        <img src="/favicon.svg" alt="" class="h-5 w-5" />
        <span aria-hidden="true" class="absolute inset-0 rounded-xl bg-emerald-500/20 opacity-0 blur-md transition group-hover:opacity-100"></span>
      </span>
      <span class="text-[15px] font-bold tracking-tight">security-audit</span>
      <span class="hidden rounded-full border border-emerald-600/25 bg-emerald-500/10 px-2 py-0.5 font-mono text-[11px] text-emerald-700 sm:inline dark:text-emerald-300">安全审计</span>
    </a>
    <div class="ml-auto hidden items-center gap-6 text-sm text-zinc-600 lg:flex dark:text-zinc-400">
      <a href="/#workflow" data-section="workflow" class="nav-link transition hover:text-zinc-950 dark:hover:text-white">工作流</a>
      <a href="/#verdicts" data-section="verdicts" class="nav-link transition hover:text-zinc-950 dark:hover:text-white">判定</a>
      <a href="/#files" data-section="files" class="nav-link transition hover:text-zinc-950 dark:hover:text-white">文件</a>
      <a href="/#install" data-section="install" class="nav-link transition hover:text-zinc-950 dark:hover:text-white">安装</a>
      <a href="/#principles" data-section="principles" class="nav-link transition hover:text-zinc-950 dark:hover:text-white">原则</a>
    </div>
    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <button id="theme-toggle" type="button" aria-pressed="true" class="rounded-full border border-zinc-300 px-3 py-1.5 font-mono text-xs text-zinc-600 transition hover:border-emerald-500/50 hover:text-emerald-700 active:scale-[0.98] dark:border-zinc-700 dark:text-zinc-300 dark:hover:text-emerald-300" aria-label="切换深浅色">
        <span id="theme-toggle-label">深色模式</span>
      </button>
      <a href="/#install" class="rounded-full bg-zinc-900 px-4 py-2 text-sm font-medium text-white shadow-[0_8px_24px_-10px_rgb(16_185_129/0.5)] transition hover:bg-zinc-700 active:scale-[0.98] dark:bg-emerald-400 dark:text-emerald-950 dark:shadow-[0_8px_24px_-10px_rgb(16_185_129/0.6)] dark:hover:bg-emerald-300">快速开始</a>
    </div>
  </nav>
  <nav aria-label="移动端章节导航" class="border-t border-zinc-200/70 lg:hidden dark:border-zinc-800/70">
    <div class="code-scroll ticker-mask mx-auto flex max-w-7xl items-center gap-5 overflow-x-auto whitespace-nowrap px-4 py-2 text-sm text-zinc-600 sm:px-6 dark:text-zinc-400">
      <a href="/#workflow" class="transition hover:text-zinc-950 dark:hover:text-white">工作流</a>
      <a href="/#verdicts" class="transition hover:text-zinc-950 dark:hover:text-white">判定</a>
      <a href="/#files" class="transition hover:text-zinc-950 dark:hover:text-white">文件</a>
      <a href="/#install" class="transition hover:text-zinc-950 dark:hover:text-white">安装</a>
      <a href="/#principles" class="transition hover:text-zinc-950 dark:hover:text-white">原则</a>
    </div>
  </nav>
</header>
