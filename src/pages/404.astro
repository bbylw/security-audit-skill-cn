---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="页面不存在 — security-audit 安全审计"
  description="你访问的地址没有对应页面。返回首页查看六阶段审计工作流、文件清单与安装方式。"
  noindex
>
  <Navbar />
  <main class="mx-auto flex max-w-7xl flex-col items-start px-4 py-20 sm:px-6 lg:py-28">
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-300">Error 404 · 未找到</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-[1.05] tracking-tighter md:text-5xl">没有这个页面</h1>
    <p class="mt-4 max-w-[52ch] leading-relaxed text-zinc-600 dark:text-zinc-400">
      链接可能已失效，或地址打错了。本站主体只有一页，直接回首页即可。
    </p>
    <a href="/" class="mt-8 rounded-full bg-emerald-700 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-800 active:scale-[0.98] dark:bg-emerald-400 dark:text-emerald-950 dark:hover:bg-emerald-300">返回首页</a>
  </main>
  <Footer />
</Layout>
